# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis na Vercel.
# NUNCA coloque valores reais neste arquivo.

# --- Supabase (Project Settings › API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a antiga "anon key". Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou a antiga "service_role key". SOMENTE servidor.
SUPABASE_SECRET_KEY=

# --- Site ---
# Endereço público, usado em links de agendamento, SEO e e-mails de senha.
NEXT_PUBLIC_SITE_URL=https://unhasdefada.com.br

# Sal para anonimizar o IP no limite de requisições (texto aleatório longo).
RATE_LIMIT_SALT=

# --- Tarefas agendadas (fila de WhatsApp) ---
# Texto aleatório longo. A Vercel envia "Authorization: Bearer CRON_SECRET".
CRON_SECRET=

# --- WhatsApp automático (DESATIVADO) ---
# Só preencha depois de contratar um provedor. Veja docs/whatsapp.md.
# WHATSAPP_PROVIDER=meta-cloud
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
